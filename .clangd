# OpenTune clangd 配置
# 编译参数全部来自 Ninja 构建目录的 compile_commands.json（windows-ara-ninja
# preset 已开启 CMAKE_EXPORT_COMPILE_COMMANDS）。路径相对本文件解析，不含本机信息。
CompileFlags:
  CompilationDatabase: build-ara-ninja
  Add:
    - "-std=c++17"
    - "--target=x86_64-pc-windows-msvc"
    - "-fms-compatibility"
    - "-fms-extensions"
    - "-fno-delayed-template-parsing"

Diagnostics:
  ClangTidy:
    Remove:
      - modernize-use-trailing-return-type
      - readability-identifier-length

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes

# VST3 专属源码目录（Source/Plugin/ 整目录由 JucePlugin_Build_VST3 守卫）
---
If:
  PathMatch: .*Source[\\/]Plugin[\\/].*
CompileFlags:
  Add:
    - "-DJucePlugin_Build_VST3=1"
    - "-DJucePlugin_Build_Standalone=0"

# VST3 编辑器工厂（#if !JucePlugin_Build_Standalone 守卫）
---
If:
  PathMatch: .*Source[\\/]Editor[\\/]EditorFactoryPlugin\.cpp
CompileFlags:
  Add:
    - "-DJucePlugin_Build_VST3=1"
    - "-DJucePlugin_Build_Standalone=0"
